rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unspecified collections and paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for authenticated user ownership
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User-isolated devlogs: Only authenticated owner can read, create, update, or delete
    match /users/{userId}/devlogs/{logId} {
      allow read, write: if isOwner(userId);
    }

    // User-isolated transcripts: Only authenticated owner can access raw conversation history
    match /users/{userId}/transcripts/{transcriptId} {
      allow read, write: if isOwner(userId);
    }

    // User root profile: Strictly owner-isolated
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
