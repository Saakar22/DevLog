# =============================================================================
# DevLog Environment Configuration Template
# =============================================================================
# Copy this file to .env before running locally:
#   cp .env.example .env
#
# IMPORTANT: Never commit real API keys, secrets, or .env files to GitHub.
# =============================================================================

# GEMINI_API_KEY (Required)
# Google Gemini API key used on the server side for debugging chat & structured extraction.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PORT (Optional)
# Server listener port (defaults to 3000)
PORT=3000

# NODE_ENV (Optional)
# Application runtime mode: 'development' | 'production'
NODE_ENV=development

